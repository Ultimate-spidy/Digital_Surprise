# MongoDB Atlas connection string
DATABASE_URL=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<database-name>?retryWrites=true&w=majority

# Cloudinary URL format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Public URL used to generate share links
PUBLIC_URL=https://digital-surprise.onrender.com

NODE_ENV=development
PORT=3000
